{
  "description": "Every project the repository builds and the project references it may declare. tests/ClaimCore.ArchitectureTests holds each .fsproj to this file in both directions: an undeclared reference fails, and so does a declared one that no longer exists. Adding an edge is a reviewed change to the architecture.",
  "product": {
    "ClaimCore.Domain": [
      "ClaimCore.Contract"
    ],
    "ClaimCore.RecordFormat": [
      "ClaimCore.Domain",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Application": [
      "ClaimCore.Domain",
      "ClaimCore.RecordFormat",
      "ClaimCore.Contract"
    ],
    "ClaimCore.HostSecurity": [],
    "ClaimCore.Postgres": [
      "ClaimCore.Application",
      "ClaimCore.Domain",
      "ClaimCore.RecordFormat",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Hosting": [
      "ClaimCore.Application",
      "ClaimCore.Postgres",
      "ClaimCore.Domain",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Web": [
      "ClaimCore.HostSecurity",
      "ClaimCore.Hosting",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Cli": [
      "ClaimCore.HostSecurity",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Database": [
      "ClaimCore.HostSecurity",
      "ClaimCore.Postgres",
      "ClaimCore.Application",
      "ClaimCore.Contract"
    ],
    "ClaimCore.Contract": []
  },
  "tooling": {
    "ClaimCore.ContractGenerator": [
      "ClaimCore.Contract",
      "ClaimCore.Domain",
      "ClaimCore.Application"
    ]
  },
  "rules": {
    "onlyTheseMayReferencePostgres": [
      "ClaimCore.Hosting",
      "ClaimCore.Database"
    ],
    "onlyTheseMayReferenceHosting": [
      "ClaimCore.Web"
    ],
    "freeOfClockFileEnvironmentRandomnessAndNetwork": [
      "ClaimCore.Domain",
      "ClaimCore.RecordFormat",
      "ClaimCore.Application",
      "ClaimCore.Contract"
    ],
    "onlyTheseMayUseTimeZoneInfo": [
      "ClaimCore.Hosting",
      "ClaimCore.Database",
      "ClaimCore.Postgres"
    ],
    "recordFormatAvoidsFrameworkSerialization": [
      "ClaimCore.RecordFormat"
    ],
    "clientAvoidsServerSemantics": [
      "ClaimCore.Cli",
      "ClaimCore.Contract"
    ],
    "httpHostAvoidsDirectSemantics": [
      "ClaimCore.Web"
    ]
  }
}
