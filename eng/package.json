{
  "name": "claimcore-eng",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.10.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings ci lint release operations",
    "format": "prettier --write ci lint release operations package.json tsconfig.json .oxlintrc.json",
    "format:check": "prettier --check ci lint release operations package.json tsconfig.json .oxlintrc.json",
    "test": "node --test \"lint/**/*.test.mjs\" \"ci/**/*.test.mjs\" \"release/**/*.test.mjs\" \"operations/**/*.test.mjs\"",
    "lint:exceptions": "node lint/check-exceptions.mjs"
  },
  "dependencies": {
    "oxc-parser": "0.153.0",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
