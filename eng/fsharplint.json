{
  "ignoreFiles": [
    "artifacts/obj/",
    "src/ClaimCore.Web/wwwroot/",
    "web/"
  ],
  "globals": {
    "numIndentationSpaces": 4
  },
  "cyclomaticComplexity": {
    "enabled": true,
    "config": {
      "maxComplexity": 12
    }
  },
  "noTabCharacters": {
    "enabled": true
  },
  "trailingWhitespaceOnLine": {
    "enabled": true,
    "config": {
      "numberOfSpacesAllowed": 0,
      "oneSpaceAllowedAfterOperator": false,
      "ignoreBlankLines": false
    }
  },
  "maxLinesInFile": {
    "enabled": true,
    "config": {
      "maxLinesInFile": 500
    }
  },
  "maxNumberOfFunctionParameters": {
    "enabled": true,
    "config": {
      "maxItems": 5
    }
  },
  "maxNumberOfItemsInTuple": {
    "enabled": true,
    "config": {
      "maxItems": 4
    }
  }
}
