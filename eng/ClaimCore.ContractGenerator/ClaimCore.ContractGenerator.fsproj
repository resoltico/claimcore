<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><DefineConstants>$(DefineConstants);CONTRACT_GENERATION</DefineConstants></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ClaimCore.Contract/ClaimCore.Contract.fsproj" />
    <Compile Include="AuthoredMessages.fs" />
    <Compile Include="CommandPresentation.fs" />
    <Compile Include="InteractionDefinitions.fs" />
    <Compile Include="DescriptorRendering.fs" />
    <Compile Include="ClientValidation.fs" />
    <Compile Include="TypeScript.fs" />
    <Compile Include="BindingValidation.fs" />
    <Compile Include="CatalogValidation.fs" />
    <Compile Include="Documents.fs" />
    <Compile Include="ArtifactPublication.fs" />
    <Compile Include="Artifacts.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="../../src/ClaimCore.Contract/Localization/*.json" LogicalName="ClaimCore.Localization.%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/ClaimCore.Domain/ClaimCore.Domain.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Application/ClaimCore.Application.fsproj" />
  </ItemGroup>
</Project>
