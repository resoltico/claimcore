<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><DefineConstants>$(DefineConstants);CONTRACT_GENERATION</DefineConstants></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ClaimCore.Application.Contracts/ClaimCore.Application.Contracts.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Cli/ClaimCore.Cli.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Server/ClaimCore.Server.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Json/ClaimCore.Json.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Wire/ClaimCore.Wire.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Presentation/ClaimCore.Presentation.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Domain/ClaimCore.Domain.fsproj" />
    <Compile Include="AuthoredMessages.fs" />
    <Compile Include="CatalogRendering.fs" />
    <Compile Include="TaskAssemblers.fs" />
    <Compile Include="TypeScript.fs" />
    <Compile Include="Terms.fs" />
    <Compile Include="MessageRegisters.fs" />
    <Compile Include="CatalogValidation.fs" />
    <Compile Include="MessageGeneration.fs" />
    <Compile Include="Documents.fs" />
    <Compile Include="ArtifactPublication.fs" />
    <Compile Include="Artifacts.fs" />
    <Compile Include="Program.fs" />
    <EmbeddedResource Include="../../web/locales/*.json" LogicalName="ClaimCore.Localization.%(Filename).browser%(Extension)" />
    <EmbeddedResource Include="../../src/ClaimCore.Cli/Localization/*.json" LogicalName="ClaimCore.Localization.%(Filename).cli%(Extension)" />
    <EmbeddedResource Include="../../src/ClaimCore.Presentation/Messages/Localization/*.json" Exclude="../../src/ClaimCore.Presentation/Messages/Localization/glossary.json" LogicalName="ClaimCore.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/ClaimCore.Presentation/Messages/Localization/glossary.json" LogicalName="ClaimCore.Glossary.json" />
  </ItemGroup>
</Project>
