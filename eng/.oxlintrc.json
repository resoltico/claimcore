{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.mjs", "**/test-support.mjs", "**/settings-fixture.mjs"],
      "rules": {
        "require-await": "off"
      }
    },
    {
      "files": ["ci/workflow-graph.mjs", "ci/workflow-policy.mjs", "ci/workflow-policy.test.mjs"],
      "rules": {
        "no-template-curly-in-string": "off"
      }
    }
  ],
  "extends": ["../config/oxlint.json"]
}
