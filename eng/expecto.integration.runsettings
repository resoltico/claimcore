<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <Expecto>
    <!-- Container-backed suites overlap two owned fixtures without CPU-count Docker fanout.
         Acceptance fixtures also own an identity server and published hosts.
         Pinned YoloDev.Expecto.TestSdk 0.16.1 defaults retain fail-on-focused-tests=true,
         join-with="." and colours=0 when omitted, matching expecto.runsettings. -->
    <parallel-workers>2</parallel-workers>
  </Expecto>
</RunSettings>
