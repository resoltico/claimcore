// Prove the generated documentation is current and that regenerating it twice leaves every other
// source file exactly as it was: the check passes, and two writes are byte-idle relative to the
// starting tracked and untracked source fingerprint.
import { spawnSync } from "node:child_process";
import { existsSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "../../..");
const tool = join(
  root,
  "artifacts/bin/ClaimCore.RepositoryTools/release/ClaimCore.RepositoryTools.dll",
);

/**
 * @param {string[]} args
 * @returns {{ status: number, stdout: string }}
 */
function repositoryTools(args) {
  const run = spawnSync("dotnet", [tool, ...args], {
    cwd: root,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "inherit"],
  });
  return { status: run.status ?? 1, stdout: run.stdout };
}

/** @returns {string} */
function sourceState() {
  const { status, stdout } = repositoryTools(["source-fingerprint"]);
  const fingerprint = stdout.trim();
  if (status !== 0 || !/^[0-9a-f]{64}:[0-9a-f]{64}$/u.test(fingerprint)) {
    throw new Error("Could not establish the current tracked and untracked source fingerprint.");
  }
  return fingerprint;
}

/** @param {string} label @param {string} before */
function writeIdle(label, before) {
  if (repositoryTools(["write"]).status !== 0) {
    throw new Error(`The ${label} documentation write failed.`);
  }
  if (sourceState() !== before) {
    throw new Error(
      `The ${label} documentation write changed source relative to its starting state.`,
    );
  }
}

try {
  if (!existsSync(tool)) {
    throw new Error("Build ClaimCore.RepositoryTools before checking documentation.");
  }
  const before = sourceState();
  if (repositoryTools(["check"]).status !== 0) {
    throw new Error("Documentation check failed.");
  }
  writeIdle("first", before);
  writeIdle("second", before);
  process.stdout.write(
    "Documentation check and both byte-idle writes passed without changing existing user edits.\n",
  );
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
