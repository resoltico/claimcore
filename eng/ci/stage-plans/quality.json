{
  "producer": "quality",
  "stages": [
    {
      "id": "lint-exceptions",
      "argv": ["node", "eng/lint/check-exceptions.mjs"]
    },
    {
      "id": "suite-registry",
      "argv": ["node", "eng/ci/suites/check-registry.mjs"]
    },
    {
      "id": "pinned-tools-smoke",
      "argv": ["node", "eng/ci/tools-smoke.mjs"]
    },
    {
      "id": "clean-source",
      "argv": ["node", "eng/ci/clean-source.mjs"],
      "requires": ["dotnet"]
    },
    {
      "id": "eng-tests",
      "argv": ["npm", "--prefix", "eng", "test"],
      "requires": ["shfmt", "uv"]
    },
    {
      "id": "eng-format",
      "argv": ["npm", "--prefix", "eng", "run", "format:check"]
    },
    {
      "id": "eng-types",
      "argv": ["npm", "--prefix", "eng", "run", "typecheck"]
    },
    {
      "id": "eng-lint",
      "argv": ["npm", "--prefix", "eng", "run", "lint"]
    },
    {
      "id": "eng-npm-audit",
      "argv": ["npm", "--prefix", "eng", "audit", "--audit-level=low"]
    },
    {
      "id": "eng-npm-signatures",
      "argv": ["npm", "--prefix", "eng", "audit", "signatures"]
    },
    {
      "id": "python-format",
      "argv": ["uv", "run", "--frozen", "ruff", "format", "--check", "--no-cache"],
      "requires": ["uv"],
      "appendFiles": {
        "directories": ["."],
        "suffixes": [".py"]
      }
    },
    {
      "id": "python-lint",
      "argv": ["uv", "run", "--frozen", "ruff", "check", "--no-cache"],
      "requires": ["uv"],
      "appendFiles": {
        "directories": ["."],
        "suffixes": [".py"]
      }
    },
    {
      "id": "python-types",
      "argv": ["uv", "run", "--frozen", "mypy"],
      "requires": ["uv"],
      "appendFiles": {
        "directories": ["."],
        "suffixes": [".py"]
      }
    },
    {
      "id": "python-limits",
      "argv": ["uv", "run", "--frozen", "python", "-B", "eng/lint/check_python_limits.py"],
      "requires": ["uv"],
      "appendFiles": {
        "directories": ["."],
        "suffixes": [".py"]
      }
    },
    {
      "id": "python-audit",
      "argv": ["uv", "audit", "--frozen"],
      "requires": ["uv"]
    },
    {
      "id": "git-ignore-policy",
      "argv": ["node", "eng/ci/policy/ignore.mjs"]
    },
    {
      "id": "source-secret-scan",
      "argv": ["node", "eng/ci/scan/main.mjs", "source"]
    },
    {
      "id": "history-secret-scan",
      "argv": ["node", "eng/ci/scan/main.mjs", "history"]
    },
    {
      "id": "test-diagnostic-privacy",
      "argv": ["node", "eng/ci/policy/diagnostic-privacy.mjs"]
    },
    {
      "id": "fantomas",
      "argv": ["bash", "eng/Check-Fantomas.sh"]
    },
    {
      "id": "fsharplint",
      "argv": ["bash", "eng/Check-FSharpLint.sh"]
    },
    {
      "id": "actionlint",
      "argv": ["actionlint", "-color"],
      "requires": ["actionlint"],
      "appendFiles": {
        "directories": [".github/workflows"],
        "suffixes": [".yml", ".yaml"]
      }
    },
    {
      "id": "workflow-security",
      "argv": [
        "uv",
        "run",
        "--frozen",
        "zizmor",
        "--persona",
        "pedantic",
        "--config",
        ".github/zizmor.yml",
        "--no-progress",
        "--format=plain",
        ".github"
      ],
      "requires": ["uv"]
    },
    {
      "id": "workflow-policy",
      "argv": ["node", "eng/ci/check-workflows.mjs"]
    },
    {
      "id": "shfmt",
      "argv": ["shfmt", "-d"],
      "appendFiles": {
        "directories": ["eng", "db", "deployment"],
        "suffixes": [".sh"]
      },
      "requires": ["shfmt"]
    },
    {
      "id": "shell-limits",
      "argv": ["node", "eng/lint/check-shell.mjs"],
      "requires": ["shfmt"]
    },
    {
      "id": "shellcheck",
      "argv": ["shellcheck", "-x"],
      "appendFiles": {
        "directories": ["eng", "db", "deployment"],
        "suffixes": [".sh"]
      },
      "requires": ["shellcheck"]
    },
    {
      "id": "compose-config",
      "argv": ["docker", "compose", "--file", "deployment/compose.yaml", "config", "--quiet"],
      "env": {
        "CLAIMCORE_COMPOSE_PROJECT": "claimcore-config-{runId}",
        "CLAIMCORE_CONFIG_DIR": "/tmp/claimcore-config-{runId}",
        "CLAIMCORE_SERVICE_UID": "1654",
        "CLAIMCORE_SERVICE_GID": "1654",
        "CLAIMCORE_HOST_PORT": "0"
      },
      "requires": ["docker"]
    },
    {
      "id": "docker-cleanup-assurance",
      "argv": ["bash", "eng/Test-LabeledTestContainerCleanup.sh"],
      "group": "docker",
      "requires": ["docker"]
    },
    {
      "id": "sql-limits",
      "argv": ["node", "eng/lint/check-sql.mjs"],
      "requires": ["uv"]
    }
  ]
}
