{
  "jobs": [
    {
      "id": "setup",
      "title": "Locked restore, tools and the strict-compiler Release build",
      "mirrors": ["quality"],
      "argv": ["node", "eng/ci/source-build.mjs"],
      "scope": null
    },
    {
      "id": "docs-check",
      "title": "Generated documentation, links and contracts",
      "mirrors": ["documentation"],
      "after": ["setup"],
      "argv": ["node", "eng/ci/policy/documentation.mjs"],
      "scope": null
    },
    {
      "id": "quality",
      "title": "Source, dependency and infrastructure gates (concurrent stage runner)",
      "mirrors": ["quality"],
      "after": ["setup"],
      "argv": ["node", "eng/ci/run-stages.mjs", "quality"],
      "scope": null
    },
    {
      "id": "frontend-product",
      "title": "Locked frontend graph, SBOM and production build",
      "mirrors": ["frontend-product"],
      "after": ["setup"],
      "argv": ["node", "eng/ci/run-stages.mjs", "frontend-product"],
      "scope": [
        "^web/",
        "^eng/ci/",
        "^eng/ClaimCore\\.ContractGenerator/",
        "^src/ClaimCore\\.(Contracts|CliProtocol|Application|Domain)/",
        "^\\.node-version$",
        "^global\\.json$"
      ]
    },
    {
      "id": "frontend-gates",
      "title": "Frontend format, types, lint, tests, mutation and dependency gates",
      "mirrors": ["frontend"],
      "after": ["frontend-product"],
      "argv": ["node", "eng/ci/run-stages.mjs", "frontend"],
      "scope": [
        "^web/",
        "^eng/ci/",
        "^eng/ClaimCore\\.ContractGenerator/",
        "^src/ClaimCore\\.(Contracts|CliProtocol|Application|Domain)/",
        "^\\.node-version$",
        "^global\\.json$",
        "^config/oxlint\\.json$"
      ]
    },
    {
      "id": "tests-dotnet",
      "title": "Every registered cross-platform suite for this platform (CI runs the other platforms)",
      "mirrors": ["suites"],
      "after": ["quality", "docs-check", "frontend-gates"],
      "argv": ["node", "eng/ci/suites/suite.mjs", "run", "--cross-platform", "--build"],
      "scope": [
        "^src/",
        "^tests/",
        "^db/",
        "^eng/",
        "^docs/",
        "^web/",
        "\\.(props|targets|slnx|slnf)$",
        "^global\\.json$",
        "packages\\.lock\\.json$",
        "^deployment/",
        "^config/"
      ]
    },
    {
      "id": "tests-postgres",
      "title": "PostgreSQL integration, witness, recovery, concurrency, migration and backup suites (partitioned)",
      "mirrors": ["integration"],
      "after": ["tests-dotnet"],
      "argv": ["node", "eng/ci/suites/suite.mjs", "run", "--group", "postgres", "--build"],
      "tools": ["docker"],
      "scope": [
        "^src/",
        "^tests/",
        "^db/",
        "^eng/ci/suites/",
        "^eng/backup/.*\\.(py|sh)$",
        "^eng/Install-BackupQualificationTools\\.sh$",
        "^config/test-suites\\.json$",
        "^eng/ClaimCore\\.Docs/",
        "\\.(props|targets)$",
        "^global\\.json$",
        "packages\\.lock\\.json$"
      ]
    },
    {
      "id": "browser-coverage",
      "title": "Published CLI acceptance, all browser engines and exact same-run merged production coverage",
      "mirrors": ["publish", "acceptance", "browser", "coverage"],
      "after": ["tests-postgres", "frontend-gates"],
      "argv": ["bash", "eng/Run-LocalBrowserCoverage.sh"],
      "tools": ["docker"],
      "optional": true,
      "scope": null
    },
    {
      "id": "container-operation",
      "title": "Persistent HTTPS Docker operation and authority separation",
      "mirrors": ["deployment"],
      "after": ["frontend-gates", "quality", "docs-check"],
      "argv": ["node", "eng/ci/deployment/qualify.mjs"],
      "tools": ["docker"],
      "scope": [
        "^deployment/",
        "^eng/",
        "^src/",
        "^tests/",
        "^web/",
        "^db/",
        "^config/",
        "^\\.config/",
        "^Directory\\.(Build\\.(props|targets)|Packages\\.props)$",
        "^NuGet\\.Config$",
        "^ClaimCore\\.slnx$",
        "^global\\.json$",
        "^\\.node-version$",
        "^\\.dockerignore$",
        "^LICENSE$",
        "^prettier\\.config\\.mjs$",
        "^\\.editorconfig$",
        "^\\.github/"
      ]
    }
  ],
  "notLocal": []
}
