{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./artifacts/typescript/tsconfig.app.tsbuildinfo",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Intl"],
    "allowImportingTsExtensions": false,
    "moduleDetection": "force",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "references": [{ "path": "./tsconfig.protocol.json" }],
  "include": ["src", "../contracts/*.ts"]
}
