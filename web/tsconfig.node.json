{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./artifacts/typescript/tsconfig.node.tsbuildinfo",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "oxlint.config.ts",
    "test-completion-lint.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "scripts",
    "../contracts/client.ts",
    "../contracts/legal.ts",
    "../contracts/messages.ts",
    "src/presentation/catalogAdmission.ts",
    "src/presentation/chromeMessages.ts",
    "src/presentation/templates.ts",
    "prettier.config.mjs",
    "browser-transport-lint.config.ts"
  ]
}
