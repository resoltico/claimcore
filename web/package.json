{
  "name": "claimcore-web",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "26.12.1",
    "npm": "11.21.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build && npm run notices:generate",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "dead-code": "knip",
    "licenses:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0'",
    "notices:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
