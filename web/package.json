{
  "name": "claimcore-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "26.9.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:produce",
    "assets:produce": "npm run contract:check && tsc -b && vite build && npm run assets:size && npm run notices:generate && node scripts/write-asset-manifest.mjs",
    "assets:size": "node scripts/check-bundle-size.mjs",
    "assets:verify": "node scripts/verify-asset-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run architecture:check && eslint src tests e2e scripts vite.config.ts playwright.config.ts --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\" \"tests/**/*.css\" --max-warnings 0 && node scripts/check-css-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "dead-code": "knip",
    "contract:generate": "node scripts/regenerate-contract.mjs",
    "contract:check": "node scripts/check-contract.mjs && node scripts/check-react-aria.mjs && npm run localization:check",
    "licenses:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0'",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "architecture:check": "node --test scripts/architecture-policy.test.mjs scripts/validator-groups.test.mjs scripts/localization-policy.test.mjs scripts/localization-boundary.test.mjs",
    "localization:generate": "node scripts/localization.mjs --write",
    "localization:check": "node scripts/localization.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "intl-messageformat": "12.1.2",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "knip": "6.37.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.8",
    "rolldown": "1.2.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
