{
  "name": "claimcore-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b tsconfig.app.json && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b --pretty false",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --configLoader runner",
    "test:unit:watch": "vitest --configLoader runner",
    "dead-code": "JITI_FS_CACHE=false knip && JITI_FS_CACHE=false knip --production",
    "licenses:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0'",
    "theme": "node scripts/generate-theme.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "knip": "6.46.1",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "react-aria": "3.53.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "glob": "14.0.6",
    "playwright-core": "$@playwright/test"
  }
}
