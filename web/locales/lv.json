  "ui.recoveryCleanupUnavailable": {
    "text": "Rezultāts ir zināms, bet šo lokālo mēģinājumu neizdevās notīrīt. Tā identitāte ir saglabāta; varat vēlreiz pārbaudīt statusu.",
    "source": "1dc1592f82ad"
  },
  "ui.recoveryDescription": {
    "text": "Neizdevās apstiprināt, vai šīs izmaiņas tika reģistrētas. ClaimCore tās pārbauda jūsu vietā. Kad kopš izmaiņas sagatavošanas ir pagājis {window}, sekmīga pārbaude var galīgi apstiprināt, ka tās nav pašreizējā vēsturē. Pēc atjaunošanas pirms izmaiņas atkārtošanas lūdziet operatoram apstiprināt, ka atjaunotā vēsture aptver iepriekšējo iznākumu.",
    "source": "ce73c48c3904",
    "machineMade": true
  },
  "ui.recoveryEmpty": {
    "text": "Nav neapstiprinātu izmaiņu.",
    "source": "c2d34418a5dd"
  },
  "ui.recoveryCoordinationUnavailable": {
    "text": "Automātiskā atkopšana ir apturēta. Pārbaudiet saglabāto darbību manuāli vai atjaunojiet piekļuvi pārlūka krātuvei, lai atsāktu automātiskās pārbaudes.",
    "source": "8a69c206fcd3",
    "machineMade": true
  },
  "ui.recoveryEarlierFormat": {
    "text": "Iepriekšējais atkopšanas žurnāls ir saglabāts. Lai pārbaudītu neatrisinātās darbības, izmantojiet tam atbilstošo ClaimCore versiju un instalāciju.",
    "source": "822ed469aee8"
  },
  "ui.recoveryDamagedRecord": {
    "text": "Dažus atkopšanas ierakstus nevarēja identificēt vai nolasīt. Tie ir saglabāti. Ja zināt darbības ID, varat to pārbaudīt tieši.",
    "source": "b169f2312f6d"
  },
  "ui.recoveryListingUnavailable": {
    "text": "Atkopšanas identitātes nevar nolasīt vai atjaunināt. Esošie ieraksti ir saglabāti. Atjaunojiet piekļuvi krātuvei vai pirms atkārtota mēģinājuma atrisiniet vecākos ierakstus ar atbilstošo klientu.",
    "source": "e2277d9e955f"
  },
  "ui.recoveryUnavailable": {
    "text": "Nav nosūtīts: atkopšanas krātuve nav pieejama. Atļaujiet vietnes krātuvi vai atbrīvojiet vietu un mēģiniet vēlreiz. Pieprasījums nav nosūtīts.",
    "source": "d65945e86bb7"
