{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/domain/operationReducer.ts"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "concurrency": 4,
  "ignorePatterns": ["artifacts/**"],
  "tempDirName": "artifacts/stryker-tmp",
  "cleanTempDir": "always",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "artifacts/stryker/operation-reducer.json"
  },
  "thresholds": {
    "high": 92,
    "low": 92,
    "break": 92
  }
}
