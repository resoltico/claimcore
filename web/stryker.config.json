{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/domain/metadata.ts",
    "src/domain/operationInitial.ts",
    "src/domain/operationReducer.ts",
    "src/domain/operationRequest.ts",
    "src/presentation/preferences.ts",
    "src/presentation/presenter.ts",
    "src/presentation/messages.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "concurrency": 4,
  "ignorePatterns": ["artifacts/**"],
  "tempDirName": "artifacts/stryker-tmp",
  "cleanTempDir": "always",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "artifacts/stryker/domain-mutation.json"
  },
  "thresholds": {
    "high": 92,
    "low": 92,
    "break": 92
  },
  "tsconfigFile": "tsconfig.sandbox-rewrite-disabled.json"
}
