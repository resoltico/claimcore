{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./artifacts/typescript/tsconfig.protocol.tsbuildinfo",
    "rootDir": "..",
    "lib": ["ES2024"],
    "types": [],
    "resolveJsonModule": true,
    "noResolve": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./artifacts/typescript/protocol-types"
  },
  "include": ["src/protocol/**/*.ts", "../contracts/*.ts", "../contracts/*.json"]
}
