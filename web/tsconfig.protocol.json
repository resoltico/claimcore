{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.protocol.tsbuildinfo",
    "rootDir": "..",
    "lib": ["ES2024"],
    "types": [],
    "resolveJsonModule": true,
    "noResolve": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.cache/protocol-types"
  },
  "include": ["src/protocol/**/*.ts", "../contracts/*.ts", "../contracts/*.json"],
  "files": [
    "../src/ClaimCore.Protocol/Messages/Localization/en.json",
    "../src/ClaimCore.Protocol/Messages/Localization/lv.json",
    "../src/ClaimCore.Protocol/Messages/Localization/ar.json"
  ]
}
