{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimcore.local/contracts/endpoint.operation.observe.request.schema.json",
  "title": "ClaimCore endpoint.operation.observe.request.schema.json",
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
          "minLength": 36,
          "maxLength": 36
        }
      },
      "required": [
        "operationId"
      ]
    }
  },
  "$ref": "#/$defs/root"
}
