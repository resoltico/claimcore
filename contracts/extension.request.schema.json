{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimcore.local/contracts/extension.request",
  "title": "Test extension request",
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "caseReference": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "act": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "SYNTHETIC_CORRECTION"
            },
            "groups": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "syntheticGroup": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mode": {
                          "const": "REPLACE"
                        },
                        "values": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "syntheticText": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "syntheticText"
                          ]
                        }
                      },
                      "required": [
                        "mode",
                        "values"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mode": {
                          "const": "KEEP"
                        }
                      },
                      "required": [
                        "mode"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "syntheticGroup"
              ]
            }
          },
          "required": [
            "kind",
            "groups"
          ]
        }
      },
      "required": [
        "operationId",
        "caseReference",
        "expectedRevision",
        "act"
      ]
    }
  },
  "$ref": "#/$defs/root"
}
