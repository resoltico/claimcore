ded; may differ from the claimed amount.","meaningId":"field.payableAmount.meaning","allowsAbsence":true,"scalar":{"kind":"AMOUNT","grammar":"(0|[1-9][0-9]{0,17})(\\.[0-9]{1,4})?","maximumIntegerDigits":18,"maximumFractionalDigits":4}},{"name":"payableCurrency","label":"Currency of amount to be paid","labelId":"field.payableCurrency.label","meaning":"Currency of the amount to be paid. Not recorded until decided; may differ from the claimed currency.","meaningId":"field.payableCurrency.meaning","allowsAbsence":true,"scalar":{"kind":"CURRENCY","grammar":"[A-Z]{3}","exactCharacters":3}},{"name":"paymentDate","label":"Payment date","labelId":"field.paymentDate.label","meaning":"Date when the full decided amount was paid, as recorded by the handler. Leave unrecorded if unpaid or unknown. Recording payment does not make or verify a bank transfer.","meaningId":"field.paymentDate.meaning","allowsAbsence":true,"scalar":{"kind":"CALENDAR_DATE","exactFormat":"yyyy-MM-dd","minimum":"0001-01-01","maximum":"9999-12-31"}},{"name":"status","label":"Case status","labelId":"field.status.label","meaning":"Whether the case is open or closed. Closing a case does not mean that payment was made.","meaningId":"field.status.meaning","allowsAbsence":false,"scalar":{"kind":"CASE_STATUS","allowedValues":["OPENED","CLOSED"]}}],"commands":[{"kind":"OPEN","label":"Close the case","meaning":"Close the case. Closing does not mean that payment was made.","labelId":"command.CLOSE.label","meaningId":"command.CLOSE.meaning","confirmationId":"ui.confirmExactRequest","inputs":{"kind":"FIELDS","fields":[{"fieldName":"incidentDate","prefill":"BLANK"},{"fieldName":"incidentNotificationDate","prefill":"BLANK"},{"fieldName":"incidentCountry","prefill":"BLANK"},{"fieldName":"claimantName","prefill":"BLANK"},{"fieldName":"insurerName","prefill":"BLANK"},{"fieldName":"claimedAmount","prefill":"BLANK"},{"fieldName":"claimedCurrency","prefill":"BLANK"},{"fieldName":"reason","prefill":"BLANK"}]}},{"kind":"AMEND_REG