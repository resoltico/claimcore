{"descriptors":{"fields":[{"name":"incidentDate","label":"Payment date","labelId":"field.paymentDate.label","meaning":"Date when the full decided amount was paid, as recorded by the handler. Leave unrecorded if unpaid or unknown. Recording payment does not make or verify a bank transfer.","meaningId":"field.paymentDate.meaning","allowsAbsence":false,"scalar":{"kind":"CALENDAR_DATE","exactFormat":"yyyy-MM-dd","minimum":"0001-01-01","maximum":"9999-12-31"}},{"name":"incidentNotificationDate","label":"Incident notification date (FNOL)","labelId":"field.incidentNotificationDate.label","meaning":"Date when this claims handler was first notified of the incident by anyone, not necessarily the claimant. Not the date another insurer or organisation was notified.","meaningId":"field.incidentNotificationDate.meaning","allowsAbsence":false,"scalar":{"kind":"CALENDAR_DATE","exactFormat":"yyyy-MM-dd","minimum":"0001-01-01","maximum":"9999-12-31"}},{"name":"incidentCountry","label":"Country of incident (ISO alpha-2 code)","labelId":"field.incidentCountry.label","meaning":"Two uppercase ASCII letters identifying the incident country; ISO alpha-2 syntax only, without membership validation. ZZ means unknown or international.","meaningId":"field.incidentCountry.meaning","allowsAbsence":false,"scalar":{"kind":"TEXT","format":{"minimumCharacters":1,"grammar":"[A-Z]{2}"},"policy":null}},{"name":"claimantName","label":"Claimant name","labelId":"field.claimantName.label","meaning":"Name of the person or company making the claim.","meaningId":"field.claimantName.meaning","allowsAbsence":false,"scalar":{"kind":"TEXT","format":{"minimumCharacters":1,"grammar":null},"policy":{"maximumCharacters":200,"requiresNonBlank":true,"rejectsSurroundingWhitespace":true,"rejectsControlCharacters":true,"rejectsForbiddenInvisibleCharacters":true}}},{"name":"insurerName","label":"Responsible insurer","labelId":"field.insurerName.label","meaning":"Insurer recorded by the claims handler as responsible for this