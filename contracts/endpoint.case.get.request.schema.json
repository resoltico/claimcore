{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimcore.local/contracts/endpoint.case.get.request.schema.json",
  "title": "ClaimCore endpoint.case.get.request.schema.json",
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseReference": {
          "type": "string",
          "pattern": "^(?:[!-~]{1,80})(?![\\s\\S])",
          "minLength": 1
        }
      },
      "required": [
        "caseReference"
      ]
    }
  },
  "$ref": "#/$defs/root"
}
