{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimcore.local/contracts/endpoint.case.history.request.schema.json",
  "title": "ClaimCore endpoint.case.history.request.schema.json",
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseReference": {
          "type": "string",
          "pattern": "^(?:[!-~]{1,80})(?![\\s\\S])",
          "minLength": 1
        },
        "detail": {
          "enum": [
            "SUMMARY",
            "FULL"
          ]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "caseReference",
        "detail",
        "limit"
      ]
    }
  },
  "$ref": "#/$defs/root"
}
