{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimcore.local/contracts/endpoint.authority.execute.request.schema.json",
  "title": "ClaimCore endpoint.authority.execute.request.schema.json",
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
          "minLength": 36,
          "maxLength": 36
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "HUMAN",
                "SERVICE"
              ]
            },
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuer",
            "subject"
          ]
        },
        "act": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "REGISTER_ACTOR"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "SET_GRANT"
                },
                "role": {
                  "enum": [
                    "OWNER",
                    "CASE_READER",
                    "CASE_REGISTRAR",
                    "CASE_HANDLER",
                    "PAYMENT_RECORDER",
                    "DATA_STEWARD",
                    "AUDITOR"
                  ]
                },
                "scope": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "INSTALLATION"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "CASE"
                        },
                        "caseReference": {
                          "type": "string",
                          "pattern": "^(?:[!-~]{1,80})(?![\\s\\S])",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "caseReference"
                      ]
                    }
                  ]
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "role",
                "scope",
                "active"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "SET_ENABLED"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "enabled"
              ]
            }
          ]
        }
      },
      "required": [
        "operationId",
        "target",
        "act"
      ]
    }
  },
  "$ref": "#/$defs/root"
}
