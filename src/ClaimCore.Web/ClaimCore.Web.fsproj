<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsShippedApplication>true</IsShippedApplication>
    <OutputType>Exe</OutputType>
    <WebClientDirectory>$(MSBuildProjectDirectory)/../../web</WebClientDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot/**/*" />
    <None Remove="wwwroot/**/*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="StartupDiagnostics.fs" />
    <Compile Include="PrivateInputs.fs" />
    <Compile Include="AuthFoundation.fs" />
    <Compile Include="OidcTrustRoot.fs" />
    <Compile Include="TlsCertificate.fs" />
    <Compile Include="WebBinding.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="OidcStartup.fs" />
    <Compile Include="Security.fs" />
    <Compile Include="HttpBody.fs" />
    <Compile Include="AuthMiddleware.fs" />
    <Compile Include="Headers.fs" />
    <Compile Include="Admission.fs" />
    <Compile Include="RequestLog.fs" />
    <Compile Include="WireOutcomes.fs" />
    <Compile Include="RouteSupport.fs" />
    <Compile Include="RateLimits.fs" />
    <Compile Include="ApiDispatch.fs" />
    <Compile Include="ApiRoutes.fs" />
    <Compile Include="HostRoutes.fs" />
    <Compile Include="WebProbeTransport.fs" />
    <Compile Include="WebProbe.fs" />
    <Compile Include="WebProcessLifetime.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ClaimCore.HostSecurity/ClaimCore.HostSecurity.fsproj" />
    <ProjectReference Include="../ClaimCore.Domain/ClaimCore.Domain.fsproj" />
    <ProjectReference Include="../ClaimCore.Application/ClaimCore.Application.fsproj" />
    <ProjectReference Include="../ClaimCore.Contracts/ClaimCore.Contracts.fsproj" />
    <ProjectReference Include="../ClaimCore.Hosting/ClaimCore.Hosting.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>
  <Target Name="ConsumeFrontendAssets" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="node &quot;$(WebClientDirectory)/scripts/verify-asset-manifest.mjs&quot;" />
    <ItemGroup>
      <FrontendAsset Include="$(WebClientDirectory)/dist/**/*" />
      <ResolvedFileToPublish Include="@(FrontendAsset)">
        <RelativePath>wwwroot/%(FrontendAsset.RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
