<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Shipped applications retain one reviewed third-party notice superset beside the repository license. -->
  <ItemGroup Condition="'$(IsShippedApplication)' == 'true'">
    <None
      Include="$(MSBuildThisFileDirectory)../LICENSE"
      Link="LICENSE"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Include="$(MSBuildThisFileDirectory)../eng/licenses/*.txt;$(MSBuildThisFileDirectory)../eng/licenses/third-party-notices.json"
      Link="licenses/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
