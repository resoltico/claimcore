<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsShippedApplication>true</IsShippedApplication><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClaimCore.Catalog/ClaimCore.Catalog.fsproj" />
    <Compile Include="BuildIdentity.fs" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ClientFailures.fs" />
    <Compile Include="PrivateInputs.fs" />
    <Compile Include="FrameReader.fs" />
    <Compile Include="ContractDiscovery.fs" />
    <Compile Include="Discovery.fs" />
    <Compile Include="RemoteConfiguration.fs" />
    <Compile Include="RemoteTls.fs" />
    <Compile Include="HttpRequestDeadline.fs" />
    <Compile Include="AccessTokens.fs" />
    <Compile Include="OidcBackchannel.fs" />
    <Compile Include="OidcClient.fs" />
    <Compile Include="LoopbackCallback.fs" />
    <Compile Include="InteractiveAuthorization.fs" />
    <Compile Include="OAuthTokenClient.fs" />
    <Compile Include="RemoteAccessSession.fs" />
    <Compile Include="RemoteServiceCall.fs" />
    <Compile Include="FrameDelivery.fs" />
    <Compile Include="RemoteFrameProcessing.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../ClaimCore.Wire/ClaimCore.Wire.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../contracts/locale.*.json" LogicalName="ClaimCore.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../contracts/cli-help.json" LogicalName="ClaimCore.cli-help.json" />
    <EmbeddedResource Include="../../contracts/cli-messages.json" LogicalName="ClaimCore.cli-messages.json" />
    <EmbeddedResource Include="../../contracts/descriptors.json" LogicalName="ClaimCore.descriptors.json" />
    <EmbeddedResource Include="../../contracts/openapi.json" LogicalName="ClaimCore.openapi.json" />
    <ProjectReference Include="../ClaimCore.HostSecurity/ClaimCore.HostSecurity.fsproj" />
    <PackageReference Include="Duende.IdentityModel" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" />
  </ItemGroup>
</Project>
