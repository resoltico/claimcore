{
  "ignoreFiles": [
    "artifacts/obj/",
    "src/ClaimCore.Web/wwwroot/",
    "web/artifacts/",
    "web/coverage/",
    "web/dist/",
    "web/node_modules/",
    "web/playwright-report/",
    "web/test-results/"
  ],
  "globals": {
    "numIndentationSpaces": 4
  },
  "cyclomaticComplexity": {
    "enabled": true,
    "config": {
      "maxComplexity": 12
    }
  },
  "maxLinesInFile": {
    "enabled": true,
    "config": {
      "maxLinesInFile": 300
    }
  },
  "maxLinesInModule": {
    "enabled": true,
    "config": {
      "maxLines": 300
    }
  },
  "maxLinesInFunction": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInLambdaFunction": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInMatchLambdaFunction": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInValue": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInMember": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInConstructor": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "maxLinesInProperty": {
    "enabled": true,
    "config": {
      "maxLines": 50
    }
  },
  "noTabCharacters": {
    "enabled": true
  },
  "trailingWhitespaceOnLine": {
    "enabled": true,
    "config": {
      "numberOfSpacesAllowed": 0,
      "oneSpaceAllowedAfterOperator": false,
      "ignoreBlankLines": false
    }
  }
}
