CLAIMCORE_WEB_ORIGIN=https://claims.example.org
CLAIMCORE_WEB_LISTEN_ADDRESS=0.0.0.0
CLAIMCORE_WEB_LISTEN_PORT=5443
CLAIMCORE_WEB_STATE_DIR=/var/lib/claimcore/web
CLAIMCORE_WEB_CERTIFICATE_PATH=/etc/claimcore/runtime/web.pfx
CLAIMCORE_CONNECTION_FILE=/etc/claimcore/runtime/primary.connection
CLAIMCORE_WITNESS_CONNECTION_FILE=/etc/claimcore/runtime/witness.connection
CLAIMCORE_WITNESS_KEY_FILE=/etc/claimcore/runtime/witness-key.json
CLAIMCORE_WRITER_CAPABILITY_FILE=/etc/claimcore/runtime/writer.capability
CLAIMCORE_SUPPRESSION_KEY_FILE=/etc/claimcore/runtime/suppression-key.json
CLAIMCORE_RECOVERY_ARTIFACT_KEY_FILE=/etc/claimcore/runtime/recovery-artifact-key.json
CLAIMCORE_OIDC_ISSUER=https://identity.example.org/realms/claims
CLAIMCORE_OIDC_CLIENT_ID=claimcore-web
CLAIMCORE_OIDC_CLIENT_SECRET_FILE=/etc/claimcore/runtime/oidc-client.secret
CLAIMCORE_OIDC_API_AUDIENCE=claimcore-api
CLAIMCORE_OIDC_CLI_CLIENT_ID=claimcore-cli
CLAIMCORE_OIDC_SERVICE_CLIENT_ID=claimcore-service
