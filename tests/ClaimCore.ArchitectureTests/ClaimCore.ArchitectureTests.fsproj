<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnableExpectoTestingPlatformIntegration>true</EnableExpectoTestingPlatformIntegration>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RepositoryRoot.fs" Link="RepositoryRoot.fs" />
    <Compile Include="Inspection.fs" />
    <Compile Include="InspectionReport.fs" />
    <Compile Include="ProjectReferences.fs" />
    <Compile Include="ProjectEvaluation.fs" />
    <Compile Include="ProductPolicy.fs" />
    <Compile Include="ProductModel.fs" />
    <Compile Include="FixtureTests.fs" />
    <Compile Include="ProjectEvaluationTests.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="SurfaceTests.fs" />
    <Compile Include="ProductGraphTests.fs" />
    <Compile Include="ProductTests.fs" />
    <Compile Include="OwnershipTests.fs" />
    <Compile Include="Suite.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../eng/claimcore.testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../ClaimCore.ArchitectureFixtures/ClaimCore.ArchitectureFixtures.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Domain/ClaimCore.Domain.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.RecordFormat/ClaimCore.RecordFormat.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Application/ClaimCore.Application.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Contracts/ClaimCore.Contracts.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.HostSecurity/ClaimCore.HostSecurity.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Postgres/ClaimCore.Postgres.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Hosting/ClaimCore.Hosting.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.CliProtocol/ClaimCore.CliProtocol.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Cli/ClaimCore.Cli.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Web/ClaimCore.Web.fsproj" />
    <ProjectReference Include="../../src/ClaimCore.Database/ClaimCore.Database.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET" PrivateAssets="all" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" PrivateAssets="all" />
  </ItemGroup>
</Project>
