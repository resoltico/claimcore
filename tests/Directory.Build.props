<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Every Expecto test project on the Microsoft Testing Platform shares these settings; a project
       names only its own sources, references and optional coverage package. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <EnableExpectoTestingPlatformIntegration>true</EnableExpectoTestingPlatformIntegration>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <None
      Include="$(MSBuildThisFileDirectory)../eng/claimcore.testconfig.json"
      Link="testconfig.json"
      CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ClaimCore.Tests' Or '$(MSBuildProjectName)' == 'ClaimCore.AcceptanceTests'">
    <ClaimCoreNativeProgram Include="$(MSBuildThisFileDirectory)native/process-supervisor.c" ProgramName="claimcore-test-supervisor" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ClaimCore.Tests'">
    <ClaimCoreNativeProgram Include="$(MSBuildThisFileDirectory)native/private_file_controls.c"
                            ProgramName="claimcore-private-file-controls"
                            Headers="$(MSBuildThisFileDirectory)../src/ClaimCore.HostSecurity/native/private_file.c;$(MSBuildThisFileDirectory)../src/ClaimCore.HostSecurity/native/private_file.h" />
  </ItemGroup>
</Project>
