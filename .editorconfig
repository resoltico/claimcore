root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{fs,fsx,fsi}]
max_line_length = 100
fsharp_multiline_bracket_style = aligned
fsharp_space_before_parameter = true

[*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml,props,targets,fsproj,slnx}]
indent_size = 2
